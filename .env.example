# NormBridge LLM 运行时配置
# 复制为 .env 并填入你的真实值，应用启动时会自动加载（dotenv，process.cwd()/.env）。
# .env 已被 .gitignore 屏蔽，不会进版本库。

# --- 必填 ---
# 任何 OpenAI 兼容服务的 API key（OpenAI / Azure / DeepSeek / 阿里通义千问 / OpenRouter / 本地 vLLM 等）
OPENAI_API_KEY=sk-...

# --- 可选 ---
# OpenAI-Compatible 接口 base URL。留空走 OpenAI 官方 https://api.openai.com/v1
# 例：
#   DeepSeek      → https://api.deepseek.com/v1
#   Azure OpenAI  → https://<your-resource>.openai.azure.com/openai/deployments/<deployment-name>
#   阿里通义千问  → https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenRouter    → https://openrouter.ai/api/v1
#   本地 vLLM     → http://127.0.0.1:8000/v1
# OPENAI_BASE_URL=

# 默认模型（同时用于 Schema 编译和搜索）
# OpenAI:   gpt-4.1-mini / gpt-4.1 / gpt-4o-mini / gpt-4o
# DeepSeek: deepseek-chat / deepseek-reasoner
# Qwen:     qwen-plus / qwen-max
NORMBRIDGE_AGENT_MODEL=gpt-4.1-mini

# 可选：分别指定 Schema 编译 / 搜索的模型（不写则用 NORMBRIDGE_AGENT_MODEL）
# 编译需要长上下文 + 结构化输出，搜索可以小模型省 token。
# NORMBRIDGE_COMPILE_MODEL=gpt-4.1
# NORMBRIDGE_SEARCH_MODEL=gpt-4.1-mini

# OpenAI API 风格：chat_completions（默认，兼容最广）/ responses（OpenAI 官方新接口）
# 第三方服务（DeepSeek / Qwen / Xiaomi MiMo / vLLM / 大部分代理）只支持 chat_completions。
# 用 OpenAI 官方且想用新接口时设为 responses。
# OPENAI_API_STYLE=chat_completions

# v0.1 不分片：超长 PDF 单次喂给模型会爆上下文，所以截断。每个 text-block 大约
# 20-40 tokens。默认 2000 ≈ 25-40 页内容，安全装进 32k 窗口。模型够大可调高。
# NORMBRIDGE_MAX_BLOCKS_PER_PROMPT=2000

# 编译时每次只处理前 N 个章节（验证阶段）。默认 5。想覆盖更多章节就调大。
# NORMBRIDGE_MAX_SECTIONS=5

# 单次 LLM 请求超时（毫秒）。第三方端点慢/挂时会明确报错而不是冻住 UI。默认 120000（2 分钟）。
# NORMBRIDGE_REQUEST_TIMEOUT_MS=120000

# 单次 LLM 请求失败重试次数。默认 1。慢端点别调太高，否则失败时显得更卡。
# NORMBRIDGE_MAX_RETRIES=1
